# Copy to backend/.env (git-ignored); npm run dev / npm start read it via Node's --env-file-if-exists.
# Variables already set in your shell win over the file. No secrets are needed yet.

# Port of the HTTP server.
PORT=3000

# development | test | production
NODE_ENV=development

# Fill the in-memory store with ~1,200 invented demo orders on startup.
# Default: true everywhere except NODE_ENV=production.
SEED_DEMO_DATA=true

# Fixes the "random" behaviour of the fictional mock couriers (simulated delays, NordCargo outages),
# so a run can be repeated. Whole number; when unset, a new seed is picked and logged on every start.
# MOCK_PROVIDER_SEED=42

# How long one courier call may take before it is cancelled (milliseconds, 100–60000, default 2000).
# NordCargo usually answers in 0.4–1.2 s; about 5% of its answers take 2.5–4 s and time out (504).
# PROVIDER_TIMEOUT_MS=2000

# debug | info | warn | error | silent. Logs are JSON lines on stdout. Default: info (silent when NODE_ENV=test).
# LOG_LEVEL=info

# Shared secrets that couriers use to sign their webhooks (HMAC-SHA256). Never commit real values.
# Generate one per courier with:  openssl rand -hex 32
# Empty: that courier's webhook endpoint answers 503 WEBHOOK_NOT_CONFIGURED (the server still starts).
WEBHOOK_SECRET_SWIFTPARCEL=
WEBHOOK_SECRET_NORDCARGO=
