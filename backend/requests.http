# Requests for the VS Code REST Client extension (humao.rest-client).
# Start the server first: cd backend && npm run dev
# Then click "Send Request" above a request.
# Run "Create order" first: later requests reuse the id it returns.

@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/health

### Create order (201)
# @name createOrder
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "  Ada Lovelace ",
  "customerEmail": "  Ada.Lovelace@Example.COM ",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": 2.4,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### List orders, newest first (200)
GET {{baseUrl}}/api/orders

### Get the order created above (200)
GET {{baseUrl}}/api/orders/{{createOrder.response.body.data.id}}

### Get a missing order (404 ORDER_NOT_FOUND)
GET {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000

### Invalid: empty body (400 VALIDATION_ERROR, every field required)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{}

### Invalid: bad email, weight as a string, bad postal code (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "not-an-email",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "12#45",
  "parcelWeightKg": "2.4",
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### Invalid: negative weight (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "ada@example.com",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": -1,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### Invalid: weight above the 100 kg platform limit (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "ada@example.com",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": 150,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### Invalid: client tries to set system fields (400, unrecognized keys)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "ada@example.com",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": 2.4,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ],
  "status": "DELIVERED",
  "trackingNumber": "FAKE-123"
}

### Invalid: malformed JSON (400 INVALID_JSON)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{ "customerName": "Ada Lovelace",

### Unknown route (404 ROUTE_NOT_FOUND)
GET {{baseUrl}}/api/does-not-exist

### Create a paid order to Germany, lowercase SKU and country are normalized (201)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Lena Vogt",
  "customerEmail": "lena.vogt@example.com",
  "deliveryAddress": "Torstraße 12",
  "destinationCity": "Berlin",
  "postalCode": "10115",
  "destinationCountry": "de",
  "parcelWeightKg": 1.2,
  "paymentStatus": "PAID",
  "items": [{ "sku": "mug-stone-02", "name": "Stoneware mug", "quantity": 3, "unitPriceCents": 1890 }]
}

### Invalid: client sends totalCents, an unsupported country and a bad item (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Lena Vogt",
  "customerEmail": "lena.vogt@example.com",
  "deliveryAddress": "Torstraße 12",
  "destinationCity": "Berlin",
  "postalCode": "10115",
  "destinationCountry": "US",
  "parcelWeightKg": 1.2,
  "totalCents": 1,
  "items": [{ "sku": "a b", "name": "Stoneware mug", "quantity": 0, "unitPriceCents": "18.90" }]
}

### Search by order number, customer name or city (200)
GET {{baseUrl}}/api/orders?search=berlin

### Filter by status and limit (200)
GET {{baseUrl}}/api/orders?status=PENDING&limit=5

### Invalid: unknown status (400 VALIDATION_ERROR)
GET {{baseUrl}}/api/orders?status=LOST

### Dashboard stats (200)
GET {{baseUrl}}/api/stats/overview

### Order form options: countries, payment statuses, limits (200)
GET {{baseUrl}}/api/meta/order-form

### Courier providers: capabilities and a simulated health check (200)
# Both couriers are fictional mocks; "simulated": true means no external service was contacted.
GET {{baseUrl}}/api/couriers

### Ship the order created above with SwiftParcel (200: SHIPPED + tracking number)
POST {{baseUrl}}/api/orders/{{createOrder.response.body.data.id}}/ship
Content-Type: application/json

{ "providerId": "swiftparcel", "service": "express" }

### Ship it again (409 ALREADY_SHIPPED)
POST {{baseUrl}}/api/orders/{{createOrder.response.body.data.id}}/ship
Content-Type: application/json

{ "providerId": "swiftparcel", "service": "express" }

### The order's history: created, processing, shipped (200)
GET {{baseUrl}}/api/orders/{{createOrder.response.body.data.id}}/events

### Unknown courier or service (400 VALIDATION_ERROR)
POST {{baseUrl}}/api/orders/{{createOrder.response.body.data.id}}/ship
Content-Type: application/json

{ "providerId": "parcelpigeon", "service": "overnight" }

### An order NordCargo will refuse: no house number in the street (create it first)
# @name noHouseNumber
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Elin Andersson",
  "customerEmail": "elin.andersson@example.com",
  "deliveryAddress": "Götgatan",
  "destinationCity": "Stockholm",
  "postalCode": "118 46",
  "destinationCountry": "SE",
  "parcelWeightKg": 1.5,
  "items": [{ "sku": "MUG-STONE-02", "name": "Stoneware mug", "quantity": 1, "unitPriceCents": 1890 }]
}

### NordCargo rejects it (422 PROVIDER_REJECTED, the order becomes FAILED)
# NordCargo is also unavailable in about 20% of calls: then the answer is 502 PROVIDER_UNAVAILABLE.
POST {{baseUrl}}/api/orders/{{noHouseNumber.response.body.data.id}}/ship
Content-Type: application/json

{ "providerId": "nordcargo", "service": "standard" }

### Ask the courier about the shipped order (200, read-only: the order is not changed)
GET {{baseUrl}}/api/orders/{{createOrder.response.body.data.id}}/tracking

### Recent courier calls and a summary per courier (200). Empty until an order is shipped in this run.
GET {{baseUrl}}/api/integrations/activity

### Idempotency-Key: send this twice. One order is created; the second answer has "Idempotent-Replayed: true".
POST {{baseUrl}}/api/orders
Content-Type: application/json
Idempotency-Key: demo-key-0001

{
  "customerName": "Sofía López",
  "customerEmail": "sofia.lopez@example.com",
  "deliveryAddress": "Calle de Atocha 27",
  "destinationCity": "Madrid",
  "postalCode": "28012",
  "destinationCountry": "ES",
  "parcelWeightKg": 0.8,
  "paymentStatus": "PAID",
  "items": [{ "sku": "NB-A5-06", "name": "A5 dot-grid notebook", "quantity": 2, "unitPriceCents": 1290 }]
}

### Same key, different body (422 IDEMPOTENCY_KEY_REUSED)
POST {{baseUrl}}/api/orders
Content-Type: application/json
Idempotency-Key: demo-key-0001

{ "customerName": "Someone else" }

### Webhooks are signed: send them with the simulator instead (see docs/webhooks.md)
#   npm run simulate:webhook -- --provider swiftparcel --tracking <tracking number> --status in_transit
# An unsigned request is refused (401 INVALID_SIGNATURE):
POST {{baseUrl}}/api/webhooks/swiftparcel
Content-Type: application/json

{"id":"evt_unsigned","tracking_number":"SP0000000001","status":"delivered","occurred_at":"2026-10-25T15:00:00.000Z"}
