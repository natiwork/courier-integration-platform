# Requests for the VS Code REST Client extension (humao.rest-client).
# Start the server first: cd backend && npm run dev
# Then click "Send Request" above a request.
# Run "Create order" first: later requests reuse the id it returns.

@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/health

### Create order (201)
# @name createOrder
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "  Ada Lovelace ",
  "customerEmail": "  Ada.Lovelace@Example.COM ",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": 2.4,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### List orders, newest first (200)
GET {{baseUrl}}/api/orders

### Get the order created above (200)
GET {{baseUrl}}/api/orders/{{createOrder.response.body.data.id}}

### Get a missing order (404 ORDER_NOT_FOUND)
GET {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000

### Invalid: empty body (400 VALIDATION_ERROR, every field required)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{}

### Invalid: bad email, weight as a string, bad postal code (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "not-an-email",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "12#45",
  "parcelWeightKg": "2.4",
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### Invalid: negative weight (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "ada@example.com",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": -1,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### Invalid: weight above the 100 kg platform limit (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "ada@example.com",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": 150,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ]
}

### Invalid: client tries to set system fields (400, unrecognized keys)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Ada Lovelace",
  "customerEmail": "ada@example.com",
  "deliveryAddress": "12 Analytical Street",
  "destinationCity": "London",
  "postalCode": "N1 9GU",
  "parcelWeightKg": 2.4,
  "destinationCountry": "GB",
  "items": [
    { "sku": "KIT-POUR-01", "name": "Pour-over set", "quantity": 2, "unitPriceCents": 1250 },
    { "sku": "FLT-100", "name": "Paper filters", "quantity": 1, "unitPriceCents": 499 }
  ],
  "status": "DELIVERED",
  "trackingNumber": "FAKE-123"
}

### Invalid: malformed JSON (400 INVALID_JSON)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{ "customerName": "Ada Lovelace",

### Unknown route (404 ROUTE_NOT_FOUND)
GET {{baseUrl}}/api/does-not-exist

### Create a paid order to Germany, lowercase SKU and country are normalized (201)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Lena Vogt",
  "customerEmail": "lena.vogt@example.com",
  "deliveryAddress": "Torstraße 12",
  "destinationCity": "Berlin",
  "postalCode": "10115",
  "destinationCountry": "de",
  "parcelWeightKg": 1.2,
  "paymentStatus": "PAID",
  "items": [{ "sku": "mug-stone-02", "name": "Stoneware mug", "quantity": 3, "unitPriceCents": 1890 }]
}

### Invalid: client sends totalCents, an unsupported country and a bad item (400)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "customerName": "Lena Vogt",
  "customerEmail": "lena.vogt@example.com",
  "deliveryAddress": "Torstraße 12",
  "destinationCity": "Berlin",
  "postalCode": "10115",
  "destinationCountry": "US",
  "parcelWeightKg": 1.2,
  "totalCents": 1,
  "items": [{ "sku": "a b", "name": "Stoneware mug", "quantity": 0, "unitPriceCents": "18.90" }]
}

### Search by order number, customer name or city (200)
GET {{baseUrl}}/api/orders?search=berlin

### Filter by status and limit (200)
GET {{baseUrl}}/api/orders?status=PENDING&limit=5

### Invalid: unknown status (400 VALIDATION_ERROR)
GET {{baseUrl}}/api/orders?status=LOST
