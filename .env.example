# Copy to .env (git-ignored) next to docker-compose.yml. Docker Compose reads it for the PostgreSQL container.
# Use your own values; backend/.env must use the same user, password, port and database in DATABASE_URL.
# Generate a password with:  openssl rand -hex 24

POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me
POSTGRES_DB=courier_dev
# Port on your machine (localhost only). Change it if another PostgreSQL already uses 5432.
POSTGRES_PORT=5432
