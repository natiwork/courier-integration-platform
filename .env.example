# Copy to .env (git-ignored) next to docker-compose.yml: cp .env.example .env. It works as it is for a local demo.
# Use your own values; backend/.env must use the same user, password, port and database in DATABASE_URL.
# Generate a password with:  openssl rand -hex 24

POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me
POSTGRES_DB=courier_dev
# Port on your machine (localhost only). Change it if another PostgreSQL already uses 5432.
POSTGRES_PORT=5432

# Port of the whole app on your machine (docker compose up --build → http://localhost:8080).
APP_PORT=8080

# Optional: fixed webhook secrets for the Docker backend (at least 32 characters, e.g. openssl rand -hex 32).
# Empty: the backend picks a random one per start, which is all the built-in webhook simulator needs.
# WEBHOOK_SECRET_SWIFTPARCEL=
# WEBHOOK_SECRET_NORDCARGO=
